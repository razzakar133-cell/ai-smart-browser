{
  "name": "ai-smart-browser-hybrid",
  "version": "1.6.0",
  "description": "Hybrid Chrome-style browser with a premium AI assistant panel",
  "main": "src/main.js",
  "repository": "github:razzakar133-cell/ai-smart-browser",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.12"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.smartai.browser",
    "productName": "AI Smart Browser",
    "publish": {
      "provider": "github"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}